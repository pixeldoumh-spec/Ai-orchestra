# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only credentials. Never expose these with NEXT_PUBLIC_. Use a current sb_secret_* key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
INTERNAL_WORKER_SECRET=replace-with-a-long-random-secret

# Optional real model adapter
AI_MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_INPUT_USD_PER_MILLION=0.05
AI_OUTPUT_USD_PER_MILLION=0.25

# Runtime policy
TASK_MAX_STEPS=12
TASK_LEASE_SECONDS=600
