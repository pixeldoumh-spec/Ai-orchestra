# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=
INTERNAL_WORKER_SECRET=

# Model adapter
AI_MODEL_PROVIDER=mock
AI_PLANNER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0

# Runtime policy
TASK_MAX_BATCHES=12
TASK_MAX_STEPS=12
TASK_MAX_REPLANS=2
TASK_LEASE_SECONDS=600
APPROVAL_TTL_SECONDS=1800

# V4 credential vault. Each active key must decode to exactly 32 bytes.
CREDENTIAL_ACTIVE_KEY_VERSION=1
CREDENTIAL_MASTER_KEY_V1=
\nNETWORK_LEASE_SECONDS=300\n