{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-orchestra-background",
  "main": "workers/background.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "ai-orchestra-tasks-v66",
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ai-orchestra-tasks-v66-dlq",
        "max_concurrency": 3,
        "retry_delay": 15
      }
    ]
  },
  "services": [
    {
      "binding": "ORCHESTRATOR",
      "service": "ai-orchestra"
    }
  ],
  "vars": {}
}
